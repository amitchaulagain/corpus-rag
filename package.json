{
  "name": "rag-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:simple": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "setup": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')){fs.writeFileSync('.env','# Your Google Cloud Project\\nGOOGLE_CLOUD_PROJECT_ID=your-project-id\\nGOOGLE_CLOUD_BUCKET_NAME=your-bucket-name\\n\\n# OAuth (Get from Google Cloud Console)\\nVITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com\\nVITE_GOOGLE_CLIENT_SECRET=your-client-secret\\n\\n# Authentication (Optional - auto-detects)\\nGOOGLE_APPLICATION_CREDENTIALS=/path/to/your/credentials.json\\n'); console.log('✅ .env created! Update with your credentials then run: bun run dev');} else {console.log('✅ .env already exists! Run: bun run dev');}\"",
    "init-jwt": "node --import tsx src/lib/init-jwt-db.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-node": "^5.3.2",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.2",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "daisyui": "^5.1.18",
    "jsdom": "^27.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.1",
    "@tailwindcss/vite": "^4.1.13",
    "bcrypt": "^6.0.0",
    "docx": "^9.5.1",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "mammoth": "^1.11.0",
    "mongodb": "^6.20.0",
    "nodemailer": "^7.0.9",
    "pdf-parse": "^2.1.7",
    "swagger-ui-dist": "^5.29.4"
  }
}
