# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id-here
GOOGLE_CLOUD_BUCKET_NAME=your-bucket-name-here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Google Cloud API Key (for clients6 endpoints)
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key-here

# Google OAuth Configuration (for client-side authentication)
VITE_GOOGLE_CLIENT_ID=your-oauth-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your-oauth-client-secret-here


